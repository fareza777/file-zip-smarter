<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hatch" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/hatch_ink</item>
        <item name="android:colorAccent">@color/hatch_lime</item>
    </style>

    <style name="Theme.Hatch.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hatch_bone</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_hatch</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Hatch</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
